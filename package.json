{
  "name": "@hollow-wake/engine",
  "version": "0.13.0",
  "description": "Instance-owned combat and character rules, extracted from Hollow Wake.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/arianna-arpg/hollow-wake-engine.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "content",
    "docs",
    "LICENSE.md",
    "NOTICE.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./content/milestone-one.json": "./content/milestone-one.json",
    "./hollow-wake": {
      "types": "./dist/hollow-wake.d.ts",
      "import": "./dist/hollow-wake.js"
    },
    "./content/burning.json": "./content/burning.json",
    "./content/firebolt.json": "./content/firebolt.json",
    "./items": {
      "types": "./dist/item-rules.d.ts",
      "import": "./dist/item-rules.js"
    },
    "./items/host": {
      "types": "./dist/item-host.d.ts",
      "import": "./dist/item-host.js"
    },
    "./passives": {
      "types": "./dist/passive-policy.d.ts",
      "import": "./dist/passive-policy.js"
    },
    "./passives/grants": {
      "types": "./dist/passive-grants.d.ts",
      "import": "./dist/passive-grants.js"
    },
    "./inventory/host": {
      "types": "./dist/inventory-host.d.ts",
      "import": "./dist/inventory-host.js"
    },
    "./inventory/stash": {
      "types": "./dist/stash-policy.d.ts",
      "import": "./dist/stash-policy.js"
    },
    "./inventory/containers": {
      "types": "./dist/container-policy.d.ts",
      "import": "./dist/container-policy.js"
    },
    "./inventory/relics": {
      "types": "./dist/relic-custody.d.ts",
      "import": "./dist/relic-custody.js"
    },
    "./inventory/actions": {
      "types": "./dist/relic-actions.d.ts",
      "import": "./dist/relic-actions.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "verify": "npm run test && node scripts/check-boundaries.mjs && node scripts/test-mutations.mjs && node scripts/test-package.mjs && node scripts/test-catalogue-package.mjs && node scripts/check-completion.mjs && node scripts/test-item-package.mjs && node scripts/test-passive-package.mjs && node scripts/test-passive-grant-package.mjs && node scripts/test-container-package.mjs",
    "example": "npm run build && node examples/first-path.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "reference:prepare": "node scripts/prepare-reference.mjs",
    "reference:install": "node scripts/install-reference-tools.mjs",
    "reference:verify": "node scripts/run-reference.mjs",
    "reference:lifecycle": "node scripts/run-lifecycle-reference.mjs",
    "adapter:prepare": "npm run build && node scripts/prepare-game-adapter.mjs",
    "adapter:verify": "node scripts/test-game-adapter.mjs",
    "benchmark:lifecycle": "npm run build && node --expose-gc scripts/benchmark-lifecycle.mjs",
    "example:lifecycle": "npm run build && node examples/casting-and-burning.mjs",
    "reference:inventory": "node scripts/run-inventory-reference.mjs",
    "catalogue:build": "node scripts/catalogue-tools.mjs",
    "benchmark:catalogue": "node --expose-gc scripts/benchmark-catalogue.mjs",
    "benchmark:inventory": "npm run build && node scripts/benchmark-inventory.mjs",
    "reference:items": "node scripts/run-item-reference.mjs",
    "items:build": "npm run build && node scripts/compile-item-content.mjs",
    "benchmark:items": "npm run build && node scripts/benchmark-items.mjs",
    "reference:item-bridge": "node scripts/run-item-bridge-reference.mjs",
    "adapter:items": "node scripts/test-game-items.mjs",
    "native:verify": "npm run build && node scripts/test-native.mjs",
    "native:pack": "node scripts/pack-native.mjs",
    "adapter:ui-source": "node scripts/test-inventory-ui-overlay.mjs",
    "reference:passives": "node scripts/run-passive-reference.mjs",
    "passives:build": "npm run build && node scripts/compile-passive-content.mjs",
    "benchmark:passives": "npm run build && node scripts/benchmark-passives.mjs",
    "reference:passive-grants": "node scripts/run-passive-grant-reference.mjs",
    "passives:grants": "npm run build && node scripts/compile-passive-grants.mjs",
    "adapter:passive-grants": "node scripts/test-game-passive-grants.mjs",
    "adapter:grant-source": "node scripts/test-passive-grant-overlay.mjs",
    "benchmark:passive-grants": "npm run build && node scripts/benchmark-passive-grants.mjs",
    "reference:policy-host": "node scripts/run-passive-policy-host-reference.mjs",
    "adapter:policy": "node scripts/test-game-passive-policy.mjs",
    "adapter:policy-source": "node scripts/test-passive-policy-overlay.mjs",
    "benchmark:policy-host": "node scripts/benchmark-passive-policy-host.mjs",
    "reference:inventory-host": "node scripts/run-inventory-host-reference.mjs",
    "adapter:inventory-host": "node scripts/test-game-inventory-host.mjs",
    "adapter:inventory-source": "node scripts/test-inventory-host-overlay.mjs",
    "benchmark:inventory-host": "node scripts/benchmark-inventory-host.mjs",
    "reference:stash": "node scripts/run-stash-reference.mjs",
    "adapter:stash": "node scripts/test-game-stash.mjs",
    "adapter:stash-source": "node scripts/test-stash-overlay.mjs",
    "benchmark:stash": "node scripts/benchmark-stash.mjs",
    "reference:containers": "node scripts/run-container-reference.mjs",
    "adapter:container-source": "node scripts/test-container-overlay.mjs",
    "adapter:containers": "node scripts/test-game-containers.mjs",
    "containers:build": "node scripts/compile-container-content.mjs",
    "benchmark:containers": "node scripts/benchmark-containers.mjs",
    "reference:relics": "node scripts/run-relic-custody-reference.mjs",
    "adapter:relic-source": "node scripts/test-relic-custody-overlay.mjs",
    "adapter:relics": "node scripts/test-game-relic-custody.mjs",
    "benchmark:relics": "node scripts/benchmark-relic-custody.mjs",
    "reference:relic-actions": "node scripts/run-relic-actions-reference.mjs",
    "adapter:relic-actions": "node scripts/test-game-relic-actions.mjs",
    "adapter:relic-actions-source": "node scripts/test-relic-actions-overlay.mjs",
    "benchmark:relic-actions": "node scripts/benchmark-relic-actions.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
