[configuration]
entry_symbol = "hollow_wake_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
windows.x86_64 = "res://addons/hollow_wake/bin/hwe_godot.dll"
linux.x86_64 = "res://addons/hollow_wake/bin/libhwe_godot.so"

[dependencies]
windows.x86_64 = {"res://addons/hollow_wake/bin/hwe_embedded.dll": ""}
linux.x86_64 = {"res://addons/hollow_wake/bin/libhwe_embedded.so": ""}
