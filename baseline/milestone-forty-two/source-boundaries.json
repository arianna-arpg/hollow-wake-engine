    "methods": [
      {
        "name": "healBy",
        "role": "extraction",
        "line": 2184,
        "sha256": "9920a6c8ed40e3537ab083d563377513a19097cd63c6d45ee48797a3fc11a8ba",
        "text": "healBy(amount: number, silent = false): number {\n    if (amount <= 0 || this.dead) return 0;\n    const before = this.life;\n    // A LIFE SEAL (Mortis Seal) locks the top of the pool below even the\n    // ceiling: heals pour against the seal and spill away.\n    const cap = this.lifeSealAt !== undefined\n      ? Math.min(this.lifeCeiling(), this.lifeSealAt)\n      : this.lifeCeiling();\n    this.life = Math.min(cap,\n      this.life + amount * this.sheet.get('healTaken'));\n    const landed = this.life - before;\n    if (landed > 0) {\n      SIM_TAP.current?.onHeal?.(this, landed);\n      this.onLifeHealed?.(landed, silent);\n      // THE RECENCY LEDGER + the 'heal' trigger's event — for REAL heals\n      // only: passive regeneration pours silently (a body that never\n      // stops regenerating is not 'recently healed', and the heal trigger\n      // must never be a free metronome).\n      if (!silent) {\n        this.noteRecent('heal');\n        this.healedSince += landed;\n      }\n    }\n    return landed;\n  }"
      },
      {
        "name": "refillLife",
        "role": "extraction",
        "line": 2232,
        "sha256": "08521ed3b4b42cb483e49b9ec5eb7e2c0d50cef75da57a8ebbc1e44f37119825",
        "text": "refillLife(): void {\n    const before = this.life;\n    this.life = this.maxLife();\n    if (this.life > before) this.onLifeHealed?.(this.life - before, true);\n  }"
      },
      {
        "name": "maxLife",
        "role": "dependency",
        "line": 2045,
        "sha256": "910481057f2ef668a8e2e3b4777bbb8e04f3a6d5ba8cd4f82197928d6e2bff57",
        "text": "maxLife(): number { return this.sheet.get('life'); }"
      },
      {
        "name": "lifeCeiling",
        "role": "dependency",
        "line": 3811,
        "sha256": "7236f3bb1f977efbef4e724f2b3217de91c40e3452756ffc8845d3046ff1f44a",
        "text": "lifeCeiling(): number {\n    return Math.max(1, this.maxLife() - this.reservedLife);\n  }"
      },
      {
        "name": "noteRecent",
        "role": "dependency",
        "line": 2427,
        "sha256": "e69a526f927357089db1d3477d5b9ad4e03169354dccd45bf0b5676901eaacd9",
        "text": "noteRecent(kind: RecentKind): void {\n    this.since[recentIndex(kind)] = 0;\n  }"
      },
      {
        "name": "fillResources",
        "role": "dependency",
        "line": 2238,
        "sha256": "6cbaf48bfdc8e3c554c645721005f02a7c6d0c3fbdd89853b39ba950eff7e198",
        "text": "fillResources(): void {\n    this.refillLife();\n    this.mana = this.maxMana();\n    this.es = this.maxEs();\n    this.poise = this.maxPoise();\n    this.insight = this.maxInsight();\n    this.endurance = this.maxEndurance();\n    this.poiseBroken = false;\n    this.poiseDelay = 0;\n    this.poiseCalm = 0;\n    this.esDelay = 0;\n    this.esRecharging = false;\n  }"
      }
    ]
  },
