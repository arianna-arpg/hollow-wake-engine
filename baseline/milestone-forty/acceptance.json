  "decisions": [
    {
      "id": "delayed-original-observations/v1",
      "rule": "Original helper and fixture bytes remain verbatim, including historical discovery-scope wording. This manifest accepts the observations, not the defective behavior as a future SDK promise."
    }
  ],
  "findings": [
    "Reverse insertion order, live per-entry clock and removal before delivery; appended entries wait for the next drain in observed cases.",
    "Captured geometry/time/tier/depth/color, borrowed effect payload and owner; level sampled per burst, team sampled per target.",
    "Native target-array iterator semantics, mitigation/healing/notification/death order and partial commits on failure.",
    "Burst heals resolve after actor updates; their heal-triggered responses wait until the following frame. World pause/slow motion govern the scheduler clock.",
    "Schedule warning failures leave the queued entry committed and skip the rider tail.",
    "A native descent wipe can replace the queue during delivery: an earlier pending entry then causes TypeError, and the old actor iterator can damage an actor already removed by loadZone.",
    "All five loaded delayed definitions are represented, including native summon-death and completed-song event paths."
  ],
  "limits": [
    "Private queue mutation/re-entry cases are diagnostics, not claims of ordinary player flows.",
    "Authored contact-batch occupancy is a controlled workload, not production-player telemetry, a capacity bound, a whole-frame benchmark or hardware acceptance.",
    "No SDK scheduler, game repair, serialized-content validator or native-engine integration is delivered by this baseline.",
    "Acceptance preserves all existing original fixtures; intended corrections need their own explicit contract before implementation."
  ]
}
